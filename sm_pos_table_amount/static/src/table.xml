<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos_table_amount.Table"
       t-inherit="pos_restaurant.Table" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('label')]" position="after">
            <div t-if="isOccupied() and smTableAmount()"
                 class="sm-table-amount position-absolute top-0 start-50 translate-middle-x"
                 t-esc="smTableAmount()"/>
        </xpath>
    </t>

</templates>
